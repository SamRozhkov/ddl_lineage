{
  "name": "ddl-lineage-frontend",
  "version": "1.0.0",
  "description": "Frontend for DDL Lineage Analyzer",
  "proxy": "http://127.0.0.1:5001",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "react-app-rewired start",
    "build": "react-app-rewired build",
    "test": "react-app-rewired test",
    "eject": "react-app-rewired eject",
    "lint:js": "eslint --ext .js,.jsx,.ts,.tsx .",
    "lint:styles": "stylelint '{styles,src}/**/*.scss'",
    "lint:prettier": "prettier --check '**/*.md'",
    "lint": "npm run lint:js && npm run lint:styles && npm run lint:prettier"
  },
  "dependencies": {
    "@gravity-ui/components": "^4.0.1",
    "@gravity-ui/graph": "^1.11.2",
    "@gravity-ui/icons": "^2.6.0",
    "@gravity-ui/navigation": "^3.1.4",
    "@gravity-ui/uikit": "^7.4.0",
    "@monaco-editor/react": "^4.7.0",
    "bem-cn-lite": "^4.1.0",
    "monaco-editor": "^0.55.1",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "sql-formatter": "^15.8.2"
  },
  "devDependencies": {
    "@gravity-ui/browserslist-config": "^4.1.0",
    "@gravity-ui/eslint-config": "^3.1.1",
    "@gravity-ui/prettier-config": "^1.1.0",
    "@gravity-ui/stylelint-config": "^4.0.0",
    "@gravity-ui/tsconfig": "^1.0.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "esbuild-sass-plugin": "^2.16.0",
    "eslint": "^8.53.0",
    "husky": "^8.0.3",
    "react-app-rewired": "^2.2.1",
    "react-scripts": "^5.0.1",
    "sass": "^1.68.0",
    "svg-inline-loader": "^0.8.2",
    "typescript": "^5.2.2"
  },
  "browserslist": [
    "extends @gravity-ui/browserslist-config"
  ],
  "lint-staged": {
    "*.{scss}": [
      "stylelint --fix --quiet"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --quiet",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  }
}
